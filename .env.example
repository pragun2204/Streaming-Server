# Application Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Public URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication & Session Security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=dev_insecure_secret_key_change_in_production_1234567890abcdef
SESSION_COOKIE_NAME=watchparty_session
SESSION_EXPIRE_HOURS=72

# Database (PostgreSQL with SQLite fallback)
# For local fallback: sqlite+aiosqlite:///./watch_party.db
# For Docker / production: postgresql+asyncpg://postgres:postgres@db:5432/watchparty
DATABASE_URL=sqlite+aiosqlite:///./watch_party.db

# Redis (for ephemeral presence & pub/sub, with in-memory fallback)
# redis://redis:6379/0
REDIS_URL=

# LiveKit SFU Settings
# Local default test keys
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_dev_key_must_be_changed_in_prod_1234567890abcdef

# Room Policies
MAX_PARTICIPANTS_PER_ROOM=10
INVITATION_EXPIRE_HOURS=24
